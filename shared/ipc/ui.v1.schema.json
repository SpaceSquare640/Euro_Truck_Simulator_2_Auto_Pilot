{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Edited by: OpenAI-Codex_Responsible: Source_Code",
  "title": "ETS2AP UI IPC v1 message",
  "description": "First validate $defs/base, then check the major version, then validate the type-specific payload. Whole-schema validation is not version detection: a 2.0 message may also fail a payload rule.",
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/hello"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "get_status"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/getStatus"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "set_config"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/setConfig"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "engage"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/engage"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "disengage"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/disengage"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello_ack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/helloAck"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "status"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/status"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/configMessage"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "log"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/log"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/error"
      }
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "type",
        "version",
        "id",
        "timestamp",
        "payload"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+$"
        },
        "id": {
          "$ref": "#/$defs/idString"
        },
        "timestamp": {
          "$ref": "#/$defs/uint64Decimal"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "uint64Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "versionString": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": true
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "GAME_NOT_RUNNING",
        "TELEMETRY_UNAVAILABLE",
        "TELEMETRY_STALE",
        "CONTROL_UNAVAILABLE",
        "MANUAL_OVERRIDE",
        "COMMAND_TIMEOUT",
        "INVALID_CONFIG",
        "UNSUPPORTED_VERSION",
        "MALFORMED_MESSAGE",
        "STALE_STATUS",
        "INTERNAL_ERROR"
      ]
    },
    "nullableNonnegative": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "telemetrySummary": {
      "type": "object",
      "required": [
        "speed_mps",
        "speed_limit_mps",
        "navigation_distance_m",
        "telemetry_age_s"
      ],
      "properties": {
        "speed_mps": {
          "$ref": "#/$defs/nullableNonnegative"
        },
        "speed_limit_mps": {
          "$ref": "#/$defs/nullableNonnegative"
        },
        "navigation_distance_m": {
          "$ref": "#/$defs/nullableNonnegative"
        },
        "telemetry_age_s": {
          "$ref": "#/$defs/nullableNonnegative",
          "description": "Age in seconds of latest valid telemetry snapshot; null if none has ever been received."
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "required": [
        "target_speed_mps"
      ],
      "properties": {
        "target_speed_mps": {
          "type": "number",
          "description": "Application range 0 to 40 m/s; out-of-range numeric values receive INVALID_CONFIG."
        }
      },
      "additionalProperties": true
    },
    "hello": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "hello"
            },
            "payload": {
              "type": "object",
              "required": [
                "supported_versions"
              ],
              "properties": {
                "supported_versions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/versionString"
                  }
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "getStatus": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "get_status"
            },
            "payload": {
              "$ref": "#/$defs/emptyPayload"
            }
          }
        }
      ]
    },
    "setConfig": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "set_config"
            },
            "payload": {
              "type": "object",
              "required": [
                "config"
              ],
              "properties": {
                "config": {
                  "$ref": "#/$defs/config"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "engage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "engage"
            },
            "payload": {
              "type": "object",
              "required": [
                "state_revision"
              ],
              "properties": {
                "state_revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "disengage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "disengage"
            },
            "payload": {
              "$ref": "#/$defs/emptyPayload"
            }
          }
        }
      ]
    },
    "helloAck": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "hello_ack"
            },
            "payload": {
              "type": "object",
              "required": [
                "selected_version"
              ],
              "properties": {
                "selected_version": {
                  "$ref": "#/$defs/versionString"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "status"
            },
            "payload": {
              "type": "object",
              "required": [
                "state",
                "error_code",
                "state_revision",
                "telemetry"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "engaged",
                    "manual_override",
                    "fault"
                  ]
                },
                "error_code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/errorCode"
                    }
                  ]
                },
                "telemetry": {
                  "$ref": "#/$defs/telemetrySummary"
                },
                "state_revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "configMessage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "config"
            },
            "payload": {
              "type": "object",
              "required": [
                "config"
              ],
              "properties": {
                "config": {
                  "$ref": "#/$defs/config"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "log": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "log"
            },
            "payload": {
              "type": "object",
              "required": [
                "level",
                "message_key",
                "args"
              ],
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ]
                },
                "message_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.]*$"
                },
                "args": {
                  "type": "object",
                  "$comment": "String values are limited here; application logic also limits serialized non-string scalars to 256 characters and rejects sensitive values.",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "error"
            },
            "payload": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "$ref": "#/$defs/errorCode"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "idString": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "UI request ids begin u-; Python-initiated event ids begin p-. Responses reuse the request id. Prefix policy is enforced by application logic."
    }
  }
}
