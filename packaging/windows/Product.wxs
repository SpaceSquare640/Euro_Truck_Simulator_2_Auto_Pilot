<!-- Edited by: OpenAI-Codex_Responsible: Source_Code -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ETS2 Auto Pilot"
           Manufacturer="Kingsley"
           Version="$(var.AppVersion)"
           UpgradeCode="aff75188-0501-4fa8-95f7-26e5d019a3ae"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ETS2 Auto Pilot" />
    </StandardDirectory>
    <Feature Id="Main" Title="ETS2 Auto Pilot" Level="1">
      <Files Include="$(var.PublishDirectory)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.PublishDirectory)\**\*.pdb" />
        <Exclude Files="$(var.PublishDirectory)\ETS2AP.Ui.exe" />
      </Files>
      <Component Id="ApplicationExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="ApplicationExecutableFile"
              Source="$(var.PublishDirectory)\ETS2AP.Ui.exe"
              KeyPath="yes">
          <Shortcut Id="ApplicationShortcut"
                    Name="ETS2 Auto Pilot"
                    Directory="ProgramMenuFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
      </Component>
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
