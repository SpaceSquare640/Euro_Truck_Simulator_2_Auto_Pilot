<Window x:Class="ETS2AP.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ETS2AP.Ui.Resources"
        Title="{x:Static res:Strings.AppTitle}" Width="1080" Height="760"
        MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated">
  <!-- Edited by: OpenAI-Codex_Responsible: Source_Code -->
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="14,22,14,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,28"/>
          <Button x:Name="OverviewNav" Content="{x:Static res:Strings.Overview}" Style="{StaticResource NavButton}" Click="Overview_Click"/>
          <Button x:Name="SetupNav" Content="{x:Static res:Strings.Setup}" Style="{StaticResource NavButton}" Click="Setup_Click"/>
          <Button x:Name="SettingsNav" Content="{x:Static res:Strings.Settings}" Style="{StaticResource NavButton}" Click="Settings_Click"/>
          <Button x:Name="ActivityNav" Content="{x:Static res:Strings.Activity}" Style="{StaticResource NavButton}" Click="Activity_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.AppVersion}" Style="{StaticResource MutedText}" Margin="12,0"/>
      </Grid>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="32,28,32,36">
        <StackPanel x:Name="OverviewPage">
          <TextBlock x:Name="OverviewHeading" Text="{x:Static res:Strings.DrivingOverview}" Style="{StaticResource PageTitle}" Focusable="True"/>
          <TextBlock Text="{x:Static res:Strings.OverviewDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,25"/>
          <Border Style="{StaticResource Card}" Background="{DynamicResource InfoBrush}" Margin="0,0,0,18">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.SetUpConnection}" Click="Setup_Click" Padding="16,9" Margin="16,0,0,0" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock x:Name="ConnectionTitle" Text="{x:Static res:Strings.NotConnected}" Foreground="{DynamicResource InfoTextBrush}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectionDetail" Text="{x:Static res:Strings.NotConnectedDetail}" Foreground="{DynamicResource InfoTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{x:Static res:Strings.DrivingInformation}" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,22"><TextBlock Text="{x:Static res:Strings.Speed}" Style="{StaticResource MutedText}"/><TextBlock x:Name="SpeedValue" Text="--" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{x:Static res:Strings.Kmh}" Style="{StaticResource MutedText}"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="{x:Static res:Strings.SpeedLimit}" Style="{StaticResource MutedText}"/><TextBlock x:Name="SpeedLimitValue" Text="--" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{x:Static res:Strings.Kmh}" Style="{StaticResource MutedText}"/></StackPanel>
                  <StackPanel Grid.Row="1"><TextBlock Text="{x:Static res:Strings.DistanceRemaining}" Style="{StaticResource MutedText}"/><TextBlock x:Name="DistanceValue" Text="--" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{x:Static res:Strings.Eta}" Style="{StaticResource MutedText}"/><TextBlock Text="--" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{x:Static res:Strings.ConnectionChecklist}" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static res:Strings.Game}"/><TextBlock x:Name="GameCheck" Grid.Column="1" Text="{x:Static res:Strings.Pending}" Style="{StaticResource MutedText}"/></Grid>
                <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static res:Strings.Connector}"/><TextBlock x:Name="ConnectorCheck" Grid.Column="1" Text="{x:Static res:Strings.Pending}" Style="{StaticResource MutedText}"/></Grid>
                <Grid Margin="0,7,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static res:Strings.ControlService}"/><TextBlock x:Name="ControlCheck" Grid.Column="1" Text="{x:Static res:Strings.Pending}" Style="{StaticResource MutedText}"/></Grid>
                <Button Content="{x:Static res:Strings.Engage}" IsEnabled="False" Padding="12,9"/>
                <TextBlock Text="{x:Static res:Strings.EngageUnavailable}" Style="{StaticResource MutedText}" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static res:Strings.RecentActivity}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.NoRecentActivity}" FontWeight="SemiBold"/><TextBlock Text="{x:Static res:Strings.ActivityAfterConnect}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Border>
          <TextBlock Text="{x:Static res:Strings.DriverPriority}" Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel x:Name="SetupPage" Visibility="Collapsed">
          <TextBlock x:Name="SetupHeading" Text="{x:Static res:Strings.SetupTitle}" Style="{StaticResource PageTitle}" Focusable="True"/>
          <TextBlock Text="{x:Static res:Strings.SetupDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,25"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{x:Static res:Strings.GameFolder}" Style="{StaticResource SectionTitle}"/><DockPanel><Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Browse}" Click="Browse_Click" Padding="14,8" Margin="12,0,0,0"/><TextBox x:Name="GameFolderText" AutomationProperties.Name="{x:Static res:Strings.GameFolder}" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel><TextBlock x:Name="FolderStatus" Text="{x:Static res:Strings.NoFolderSelected}" Style="{StaticResource MutedText}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{x:Static res:Strings.ConnectorInstallation}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.ConnectorInstallationDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,13"/><Button x:Name="InstallConnectorButton" Content="{x:Static res:Strings.InstallConnector}" IsEnabled="False" Click="InstallConnector_Click" HorizontalAlignment="Left" Padding="14,8"/><TextBlock x:Name="InstallStatus" Style="{StaticResource MutedText}" Margin="0,9,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static res:Strings.ControlService}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.ServiceUnavailable}" Style="{StaticResource MutedText}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <TextBlock x:Name="SettingsHeading" Text="{x:Static res:Strings.SettingsTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,25" Focusable="True"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{x:Static res:Strings.Appearance}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.ThemeDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,15"/><TextBlock Text="{x:Static res:Strings.Theme}" Margin="0,0,0,6"/><ComboBox x:Name="ThemePicker" AutomationProperties.Name="{x:Static res:Strings.Theme}" Width="230" HorizontalAlignment="Left" SelectionChanged="ThemePicker_SelectionChanged"><ComboBoxItem Content="{x:Static res:Strings.SystemTheme}"/><ComboBoxItem Content="{x:Static res:Strings.LightTheme}"/><ComboBoxItem Content="{x:Static res:Strings.DarkTheme}"/></ComboBox><TextBlock Text="{x:Static res:Strings.HighContrastNote}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{x:Static res:Strings.Language}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.English}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static res:Strings.KeyboardShortcuts}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.ShortcutsDescription}" Style="{StaticResource MutedText}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="ActivityPage" Visibility="Collapsed">
          <TextBlock x:Name="ActivityHeading" Text="{x:Static res:Strings.ActivityTitle}" Style="{StaticResource PageTitle}" Focusable="True"/>
          <TextBlock Text="{x:Static res:Strings.ActivityDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,25"/>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static res:Strings.NoRecentActivity}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{x:Static res:Strings.ActivityAfterConnect}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Button Content="{x:Static res:Strings.CopyStatus}" Click="CopyStatus_Click" HorizontalAlignment="Left" Padding="14,8"/><TextBlock x:Name="CopyFeedback" Style="{StaticResource MutedText}" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
