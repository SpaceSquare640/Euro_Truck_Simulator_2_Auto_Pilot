---
// Edited by: OpenAI-Codex_Responsible: Website
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AlternateLinks from "../components/AlternateLinks.astro";
import { htmlLang, t, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL("https://spacesquare640.github.io");
const socialImage = new URL(`${baseUrl}social-preview.png`, siteOrigin).toString();
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07131d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.fullName", locale)} />
    <meta property="og:title" content={`${title} | ${t("site.name", locale)}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${t("site.name", locale)}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{`${title} | ${t("site.name", locale)}`}</title>
    <AlternateLinks locale={locale} origin={siteOrigin} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t("skipToContent", locale)}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <Nav locale={locale} />
      </div>
    </header>
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  /* Edited by: OpenAI-Codex_Responsible: Website */
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #edf4f7;
    background: #07131d;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --surface: #102432;
    --surface-raised: #153041;
    --text: #edf4f7;
    --muted: #b7c8d2;
    --accent: #ffd071;
    --line: #365061;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    color: var(--text);
    background:
      radial-gradient(ellipse at 85% 0%, rgb(27 75 99 / 24%), transparent 34rem),
      #07131d;
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: #ffe1a0;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
    border-radius: 0.2rem;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.65rem 1rem;
    transform: translateY(-180%);
    border-radius: 0.5rem;
    color: #07131d;
    background: var(--accent);
    font-weight: 700;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    border-bottom: 1px solid rgb(183 200 210 / 18%);
    background: rgb(7 19 29 / 92%);
  }

  .site-header-inner,
  .site-main,
  .site-footer {
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
  }

  .site-nav {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 750;
    text-decoration: none;
  }

  .brand img {
    display: block;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-block;
    padding-block: 0.55rem;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .site-main {
    min-height: calc(100vh - 11rem);
    padding-block: clamp(3rem, 7vw, 6.5rem);
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-size: 0.83rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-heading,
  .hero-heading {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .page-intro,
  .hero-intro {
    max-width: 66ch;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero {
    padding-block: clamp(1rem, 3vw, 2.5rem) 4rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--accent);
    border-radius: 0.55rem;
    color: #07131d;
    background: var(--accent);
    font-weight: 750;
    text-decoration: none;
  }

  .button:hover {
    color: #07131d;
    background: #ffe1a0;
  }

  .button-secondary {
    color: var(--text);
    background: transparent;
  }

  .button-secondary:hover {
    color: var(--text);
    background: var(--surface);
  }

  .content-section {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
  }

  .feature-grid,
  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .link-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .feature-card,
  .link-card,
  .notice-panel {
    padding: clamp(1.2rem, 2.5vw, 1.65rem);
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: linear-gradient(145deg, rgb(21 48 65 / 86%), rgb(16 36 50 / 96%));
  }

  .feature-card h3,
  .link-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.12rem;
  }

  .feature-card p,
  .link-card p,
  .notice-panel p {
    margin: 0;
    color: var(--muted);
  }

  .link-card a {
    color: var(--text);
    text-decoration: none;
  }

  .link-card a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .outline-list {
    display: grid;
    gap: 0.85rem;
    margin: 1.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .outline-list li {
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 0.55rem 0.55rem 0;
    background: var(--surface);
  }

  .outline-list h2,
  .outline-list h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .outline-list p {
    margin: 0.3rem 0 0;
    color: var(--muted);
  }

  .status-label {
    display: inline-block;
    margin-top: 0.55rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .simulator-placeholder {
    display: grid;
    min-height: 14rem;
    place-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 2rem;
    border: 1px dashed #688094;
    border-radius: 1rem;
    background:
      linear-gradient(135deg, rgb(18 42 58 / 94%), rgb(7 19 29 / 95%)),
      repeating-linear-gradient(135deg, transparent 0 1rem, rgb(255 255 255 / 3%) 1rem 1.08rem);
    text-align: center;
  }

  .simulator-placeholder p {
    margin: 0;
    color: var(--muted);
  }

  .changelog-content {
    margin-top: 2rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--surface);
  }

  .changelog-content :where(h1, h2, h3) {
    color: var(--text);
    line-height: 1.25;
  }

  .changelog-content :where(p, li) {
    color: var(--muted);
  }

  .changelog-content :where(code) {
    overflow-wrap: anywhere;
    color: var(--accent);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(183 200 210 / 18%);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .site-nav {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 0.85rem;
    }

    .nav-links {
      justify-content: flex-start;
      gap: 0.1rem 1rem;
    }

    .feature-grid,
    .link-grid {
      grid-template-columns: 1fr;
    }

    .site-main {
      min-height: auto;
    }
  }

  /* Language switcher */
  .language-switcher {
    flex: 0 0 auto;
  }

  .language-switcher ul {
    display: flex;
    gap: 0.25rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .language-switcher a {
    display: inline-block;
    padding-block: 0.55rem;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
  }

  .language-switcher a:hover {
    color: var(--text);
  }

  .language-switcher a[aria-current="true"] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.15em;
    text-underline-offset: 0.35em;
  }

  @media (min-width: 761px) {
    .nav-links {
      margin-left: auto;
    }

    .language-switcher {
      padding-left: 1.2rem;
      border-left: 1px solid var(--line);
    }
  }

  /* Traditional Chinese typography */
  :root:lang(zh-Hant) {
    font-family: Inter, "Microsoft JhengHei", "PingFang TC", "Noto Sans TC", "Heiti TC", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  [lang="en"]:not(:root) {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :lang(zh-Hant) .page-heading,
  :lang(zh-Hant) .hero-heading {
    max-width: 16em;
    letter-spacing: 0;
    line-height: 1.25;
  }

  :lang(zh-Hant) .section-heading {
    letter-spacing: 0;
  }

  :lang(zh-Hant) .eyebrow {
    letter-spacing: 0.08em;
  }

  :lang(zh-Hant) .page-intro,
  :lang(zh-Hant) .hero-intro {
    max-width: 36em;
  }

  .changelog-notice {
    margin: 1rem 0 0;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
