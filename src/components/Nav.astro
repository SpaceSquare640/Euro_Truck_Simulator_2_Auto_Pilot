---
// Edited by: OpenAI-Codex_Responsible: Website
import { t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const links = [
  { label: t("nav.home", locale), href: `${baseUrl}en/` },
  { label: t("nav.docs", locale), href: `${baseUrl}en/docs/` },
  { label: t("nav.changelog", locale), href: `${baseUrl}en/changelog/` },
  { label: t("nav.wiki", locale), href: `${baseUrl}en/wiki/` },
  { label: t("nav.simulator", locale), href: `${baseUrl}en/simulator/` },
];
---

<nav class="site-nav" aria-label={t("nav.label", locale)}>
  <a class="brand" href={`${baseUrl}en/`}>
    <img src={`${baseUrl}icon.svg`} width="36" height="36" alt="" />
    <span>{t("site.name", locale)}</span>
  </a>
  <ul class="nav-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>
