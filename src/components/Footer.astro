---
// Edited by: OpenAI-Codex_Responsible: Website
import { localePath, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <p>
    {t("footer.copyrightPrefix", locale)}<a href={t("footer.licenseHref", locale)}>{t("footer.licenseName", locale)}</a>
  </p>
  <p>{t("footer.notAffiliated", locale)}</p>
  <nav aria-label={t("footer.navLabel", locale)}>
    <a href={localePath(locale, "#credits")}>{t("footer.creditsLink", locale)}</a>
  </nav>
</footer>
