---
// Edited by: OpenAI-Codex_Responsible: Website
import { localePath, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="notice-panel" aria-labelledby="status-banner-heading">
  <p class="eyebrow">{t("home.status.label", locale)}</p>
  <h2 id="status-banner-heading">{t("home.status.heading", locale)}</h2>
  <p>{t("home.status.body", locale)}</p>
  <a href={localePath(locale, "docs/status/")}>{t("home.status.link", locale)}</a>
</aside>
