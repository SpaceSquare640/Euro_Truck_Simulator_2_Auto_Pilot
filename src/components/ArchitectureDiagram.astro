---
// Edited by: OpenAI-Codex_Responsible: Website
import { t } from "../i18n";
---

<div class="diagram-desktop">
<svg role="img" aria-labelledby="architecture-diagram-title architecture-diagram-desc" viewBox="0 0 960 690">
  <title id="architecture-diagram-title">{t("architecture.diagramTitle")}</title>
  <desc id="architecture-diagram-desc">{t("architecture.diagramDesc")}</desc>
  <defs>
    <marker id="architecture-arrow" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto">
      <path d="M 1 1 L 10 6 L 1 11 Z" />
    </marker>
  </defs>

  <path class="connection" d="M 280 148 H 350" marker-end="url(#architecture-arrow)" />
  <path class="connection" d="M 605 148 H 675" marker-end="url(#architecture-arrow)" />
  <path class="connection" d="M 810 190 V 465" marker-end="url(#architecture-arrow)" />
  <path class="connection" d="M 810 555 V 620 H 150 V 195" marker-end="url(#architecture-arrow)" />
  <path class="connection" d="M 690 190 L 590 465" marker-end="url(#architecture-arrow)" />
  <path class="connection" d="M 605 465 L 705 190" marker-end="url(#architecture-arrow)" />

  <text class="edge-label" x="315" y="75" text-anchor="middle">{t("architecture.edge.sdk")}</text>
  <text class="edge-label" x="640" y="75" text-anchor="middle">{t("architecture.edge.shm")}</text>
  <text class="edge-label" x="842" y="330" text-anchor="middle" transform="rotate(-90 842 330)">{t("architecture.edge.controlPipe")}</text>
  <text class="edge-label" x="480" y="655" text-anchor="middle">{t("architecture.edge.virtual")}</text>
  <rect class="edge-label-background" x="405" y="330" width="310" height="32" rx="6" />
  <text class="edge-label" x="560" y="352" text-anchor="middle">{t("architecture.edge.uiPipe")}</text>

  <g class="node">
    <rect x="25" y="105" width="255" height="85" rx="12" />
    <text x="152" y="155" text-anchor="middle">{t("architecture.node.game")}</text>
  </g>
  <g class="node">
    <rect x="355" y="105" width="250" height="85" rx="12" />
    <text x="480" y="155" text-anchor="middle">{t("architecture.node.plugin")}</text>
  </g>
  <g class="node">
    <rect x="680" y="105" width="255" height="85" rx="12" />
    <text x="807" y="155" text-anchor="middle">{t("architecture.node.core")}</text>
  </g>
  <g class="node">
    <rect x="680" y="470" width="255" height="85" rx="12" />
    <text x="807" y="520" text-anchor="middle">{t("architecture.node.input")}</text>
  </g>
  <g class="node">
    <rect x="355" y="470" width="250" height="85" rx="12" />
    <text x="480" y="520" text-anchor="middle">{t("architecture.node.ui")}</text>
  </g>
</svg>
</div>

<div class="diagram-mobile" aria-hidden="true">
  <div class="flow-node">{t("architecture.node.game")}</div>
  <div class="flow-link">{t("architecture.edge.sdk")}</div>
  <div class="flow-node">{t("architecture.node.plugin")}</div>
  <div class="flow-link">{t("architecture.edge.shm")}</div>
  <div class="flow-node">{t("architecture.node.core")}</div>
  <div class="flow-branch">
    <div class="flow-link">{t("architecture.edge.controlPipe")}</div>
    <div class="flow-node">{t("architecture.node.input")}</div>
    <div class="flow-link">{t("architecture.edge.virtual")}</div>
    <div class="flow-node flow-node-return">{t("architecture.node.game")}</div>
  </div>
  <div class="flow-branch">
    <div class="flow-link flow-link-bidirectional">{t("architecture.edge.uiPipe")}</div>
    <div class="flow-node">{t("architecture.node.ui")}</div>
  </div>
</div>

<style>
  /* Edited by: OpenAI-Codex_Responsible: Website */
  svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--surface);
    font-family: inherit;
  }

  .connection {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
  }

  marker path {
    fill: var(--accent);
  }

  .node rect {
    fill: var(--surface-raised);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node text {
    fill: var(--text);
    font-size: 20px;
    font-weight: 700;
  }

  .edge-label-background {
    fill: var(--surface);
  }

  .edge-label {
    fill: var(--text);
    font-size: 18px;
    font-weight: 650;
  }

  /* Edited by: OpenAI-Codex_Responsible: Website */
  .diagram-mobile {
    display: none;
  }

  .flow-node {
    padding: 0.9rem 1rem;
    border: 2px solid var(--accent);
    border-radius: 0.75rem;
    color: var(--text);
    background: var(--surface-raised);
    font-size: 1rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .flow-node-return {
    border-style: dashed;
  }

  .flow-link {
    color: var(--muted);
    font-size: 1rem;
    text-align: center;
  }

  .flow-link::before {
    content: "\2193";
    display: inline-block;
    margin-right: 0.5rem;
    color: var(--accent);
    font-size: 1.4rem;
  }

  .flow-link-bidirectional::before {
    content: "\2195";
  }

  .flow-branch {
    display: grid;
    gap: 0.5rem;
    margin-left: 1rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
  }

  @media (max-width: 760px) {
    .diagram-desktop {
      display: none;
    }

    .diagram-mobile {
      display: grid;
      gap: 0.5rem;
    }
  }
</style>
