---
// Edited by: OpenAI-Codex_Responsible: Website
import Base from "../layouts/Base.astro";
import { t } from "../i18n";

const baseUrl = import.meta.env.BASE_URL;
const homeUrl = `${baseUrl}en/`;
---

<Base title={t("redirect.title")} description={t("redirect.description")}>
  <meta http-equiv="refresh" content={`0;url=${homeUrl}`} slot="head" />
  <section class="notice-panel" aria-labelledby="redirect-heading">
    <h1 class="page-heading" id="redirect-heading">{t("redirect.title")}</h1>
    <p>{t("redirect.message")} <a href={homeUrl}>{t("redirect.link")}</a></p>
  </section>
</Base>
