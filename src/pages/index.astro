---
// Edited by: OpenAI-Codex_Responsible: Website
import Base from "../layouts/Base.astro";
import { defaultLocale, localePath, t } from "../i18n";

const homeUrl = localePath(defaultLocale);
---

<Base title={t("redirect.title", defaultLocale)} description={t("redirect.description", defaultLocale)} locale={defaultLocale}>
  <meta http-equiv="refresh" content={`0;url=${homeUrl}`} slot="head" />
  <section class="notice-panel" aria-labelledby="redirect-heading">
    <h1 class="page-heading" id="redirect-heading">{t("redirect.title", defaultLocale)}</h1>
    <p>{t("redirect.message", defaultLocale)} <a href={homeUrl}>{t("redirect.link", defaultLocale)}</a></p>
  </section>
</Base>
