---
// Edited by: OpenAI-Codex_Responsible: Website
import Base from "../../../layouts/Base.astro";
import { t } from "../../../i18n";

const rows = [
  { item: t("status.row.architecture"), state: t("label.draft") },
  { item: t("status.row.interfaces"), state: t("label.draft"), note: t("status.row.interfacesNote") },
  { item: t("status.row.checks"), state: t("label.available") },
  { item: t("status.row.plugin"), state: t("label.notStarted") },
  { item: t("status.row.input"), state: t("label.notStarted") },
  { item: t("status.row.core"), state: t("label.notStarted") },
  { item: t("status.row.ui"), state: t("label.notStarted") },
  { item: t("status.row.simulator"), state: t("label.planned"), note: t("status.row.simulatorNote") },
  { item: t("status.row.release"), state: t("label.notScheduled") },
];
const roadmap = [
  t("status.roadmap.one"),
  t("status.roadmap.two"),
  t("status.roadmap.three"),
  t("status.roadmap.four"),
  t("status.roadmap.five"),
];
---

<Base title={t("status.title")} description={t("status.description")}>
  <h1 class="page-heading">{t("status.heading")}</h1>
  <p class="page-intro">{t("status.intro")}</p>
  <p>{t("status.updated")}</p>

  <section class="content-section" aria-labelledby="status-table-heading">
    <h2 class="section-heading" id="status-table-heading">{t("status.tableHeading")}</h2>
    <div class="table-scroll">
      <table>
        <caption>{t("status.tableCaption")}</caption>
        <thead>
          <tr>
            <th scope="col">{t("status.col.item")}</th>
            <th scope="col">{t("status.col.state")}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.item}</th>
              <td>
                <span class="status-label">{row.state}</span>
                {row.note && <p>{row.note}</p>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="content-section" aria-labelledby="status-roadmap-heading">
    <h2 class="section-heading" id="status-roadmap-heading">{t("status.roadmapHeading")}</h2>
    <p>{t("status.roadmapIntro")}</p>
    <ol class="outline-list">
      {roadmap.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <ul class="outline-list">
    <li><a href={`${import.meta.env.BASE_URL}en/changelog/`}>{t("status.changelogLink")}</a></li>
    <li><a href={`${import.meta.env.BASE_URL}en/docs/`}>{t("status.backLink")}</a></li>
  </ul>
</Base>

<style>
  /* Edited by: OpenAI-Codex_Responsible: Website */
  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 34rem;
    margin-top: 1.5rem;
    border-collapse: collapse;
  }

  caption {
    padding-bottom: 0.7rem;
    color: var(--muted);
    text-align: left;
  }

  th,
  td {
    padding: 0.8rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--text);
  }

  td p {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }
</style>
