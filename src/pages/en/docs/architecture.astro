---
// Edited by: OpenAI-Codex_Responsible: Website
import Base from "../../../layouts/Base.astro";
import ArchitectureDiagram from "../../../components/ArchitectureDiagram.astro";
import { t } from "../../../i18n";

const flow = [
  t("architecture.flow.one"),
  t("architecture.flow.two"),
  t("architecture.flow.three"),
  t("architecture.flow.four"),
  t("architecture.flow.five"),
];
const modules = [
  { name: t("architecture.module.plugin.name"), language: t("architecture.module.plugin.language"), role: t("architecture.module.plugin.role") },
  { name: t("architecture.module.input.name"), language: t("architecture.module.input.language"), role: t("architecture.module.input.role") },
  { name: t("architecture.module.core.name"), language: t("architecture.module.core.language"), role: t("architecture.module.core.role") },
  { name: t("architecture.module.ui.name"), language: t("architecture.module.ui.language"), role: t("architecture.module.ui.role") },
];
const safety = [
  t("architecture.safety.one"),
  t("architecture.safety.two"),
  t("architecture.safety.three"),
  t("architecture.safety.four"),
  t("architecture.safety.five"),
];
---

<Base title={t("architecture.title")} description={t("architecture.description")}>
  <h1 class="page-heading">{t("architecture.heading")}</h1>
  <p class="page-intro">{t("architecture.intro")}</p>

  <section class="content-section" aria-labelledby="architecture-flow-heading">
    <h2 class="section-heading" id="architecture-flow-heading">{t("architecture.flowHeading")}</h2>
    <ArchitectureDiagram />
    <ol class="outline-list">
      {flow.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="content-section" aria-labelledby="architecture-modules-heading">
    <h2 class="section-heading" id="architecture-modules-heading">{t("architecture.modulesHeading")}</h2>
    <div class="table-scroll">
      <table>
        <caption>{t("architecture.modulesCaption")}</caption>
        <thead>
          <tr>
            <th scope="col">{t("architecture.col.module")}</th>
            <th scope="col">{t("architecture.col.language")}</th>
            <th scope="col">{t("architecture.col.role")}</th>
          </tr>
        </thead>
        <tbody>
          {modules.map((module) => (
            <tr>
              <th scope="row">{module.name}</th>
              <td>{module.language}</td>
              <td>{module.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="content-section" aria-labelledby="architecture-safety-heading">
    <h2 class="section-heading" id="architecture-safety-heading">{t("architecture.safetyHeading")}</h2>
    <p>{t("architecture.safetyIntro")}</p>
    <ul class="outline-list">
      {safety.map((principle) => <li>{principle}</li>)}
    </ul>
  </section>

  <ul class="outline-list">
    <li><a href={`${import.meta.env.BASE_URL}en/docs/`}>{t("architecture.backLink")}</a></li>
    <li><a href={`${import.meta.env.BASE_URL}en/docs/status/`}>{t("architecture.statusLink")}</a></li>
  </ul>
</Base>

<style>
  /* Edited by: OpenAI-Codex_Responsible: Website */
  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 42rem;
    margin-top: 1.5rem;
    border-collapse: collapse;
  }

  caption {
    padding-bottom: 0.7rem;
    color: var(--muted);
    text-align: left;
  }

  th,
  td {
    padding: 0.8rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--text);
  }
</style>
